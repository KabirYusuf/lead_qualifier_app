# Copy this file to `.env` and adjust as needed.
# All values are optional -- CLI arguments always override these,
# and sensible defaults are used if neither is set.

# Path to the raw lead export CSV to process.
LEADS_INPUT_PATH=Cohort 3 Assessment — Task 1 Leads (messy).csv

# Where the ranked/scored output CSV should be written.
LEADS_OUTPUT_PATH=output/ranked_leads.csv

# Score (0-100) at/above which a lead is recommended "Contact Now".
CONTACT_NOW_THRESHOLD=65

# Score (0-100) at/above which a lead is recommended "Nurture"
# (below this it falls to "Disqualify").
NURTURE_THRESHOLD=40
